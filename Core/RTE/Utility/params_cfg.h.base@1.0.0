// Shared/inc/params_cfg.h
#ifndef PARAMS_CFG_H
#define PARAMS_CFG_H

//-------- <<< Use Configuration Wizard in Context Menu >>> --------------------

// <h> Pagina de parametros
//   <o> Direccion del sector A <0x08000000-0x080FFFFF:0x800>
//   <i> Debe quedar fuera de las regiones ROM del Bootloader y de la App.
#define PARAM_A_BASE          0x08008000

//   <o> Tamano de sector
//     <0x800=>  2 KB
//     <0x2000=> 8 KB
//     <0x4000=> 16 KB
#define PARAM_SECTOR_SZ       0x4000

//   <q> Doble buffer A/B
//   <i> Escritura segura frente a cortes de alimentacion.
#define PARAM_DOUBLE_BUFFER   1

//   <o> Version del layout <0-65535>
#define PARAM_LAYOUT_VER      1
// </h>

// <e> Valores por defecto de fabrica
#define PARAM_USE_DEFAULTS    1
//   <o> Baudrate UART
//     <9600=>   9600
//     <115200=> 115200
#define PARAM_DEF_BAUD        9600
//   <s.15> Nombre del dispositivo
#define PARAM_DEF_NAME        "MyDevice"
// </e>

//------------- <<< end of configuration section >>> ---------------------------
#endif
